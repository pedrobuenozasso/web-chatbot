# URL privada do serviço atual, sem /v1/messages no final.
CHATBOT_API_URL=http://zasso-chatbot:3000

# Mesmo segredo longo configurado no backend. Nunca usar NEXT_PUBLIC_.
CHATBOT_API_TOKEN=

# Links de agenda para o botão "Marcar reunião" ao final da triagem.
# Não são segredo (são só o link público do calendário), por isso podem ser
# NEXT_PUBLIC_. Sem eles configurados, o botão de reunião simplesmente não
# aparece e só o botão do WhatsApp é exibido.
# Segmento Agro: se vazio, cai no link comercial abaixo.
NEXT_PUBLIC_MEETING_URL_AGRO=
# Segmento comercial/área urbana (também usado como padrão do Agro).
NEXT_PUBLIC_MEETING_URL_COMERCIAL=
